# Copy to .env and fill in. .env is git-ignored.

# Used by docker-compose.yml to create the local database
POSTGRES_USER=jobsite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobsite_twin
POSTGRES_PORT=5432

# Used by the server, migrations and seed (must match the values above)
DATABASE_URL=postgres://jobsite:change-me@localhost:5432/jobsite_twin

# GraphQL server port
PORT=4000
